# Frontend bind address. Use 0.0.0.0 to open both localhost and external IP access.
FRONTEND_HOST=0.0.0.0
FRONTEND_PUBLIC_HOST=111.88.152.26
VITE_DEV_HOST=0.0.0.0

# Ports.
PORT=3001
VITE_DEV_PORT=5173

# Backend/API gateway for dev proxy and production proxy.
API_GATEWAY_URL=http://localhost:8000

# Browser-side API paths. Keep relative when frontend server proxies /api and /notifications.
VITE_API_URL=/api/v1
VITE_NOTIFICATIONS_URL=/notifications

# Optional: comma-separated hostnames for Vite dev host checks.
# IP addresses and localhost are allowed by Vite by default.
VITE_ALLOWED_HOSTS=localhost,111.88.152.26
